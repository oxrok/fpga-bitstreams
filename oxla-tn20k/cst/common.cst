// Sipeed Tang Nano 20K (GW2AR-LV18QN88C8/I7). Numbers are QN88 pins, which
// are also the labels on the board's headers.
//
// The SDRAM is inside the package; nextpnr places the O_sdram_* and
// IO_sdram_dq ports by name, so they have no entry here.

IO_LOC  "clk27" 4;
IO_PORT "clk27" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

// UART to the BL616 (the board's USB serial port).
IO_LOC  "uart_tx" 69;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC  "uart_rx" 70;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// LEDs, active low: alive, rx, running, triggered, done, overflow.
IO_LOC  "led_n[0]" 15;
IO_LOC  "led_n[1]" 16;
IO_LOC  "led_n[2]" 17;
IO_LOC  "led_n[3]" 18;
IO_LOC  "led_n[4]" 19;
IO_LOC  "led_n[5]" 20;
IO_PORT "led_n[0]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led_n[1]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led_n[2]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led_n[3]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led_n[4]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led_n[5]" IO_TYPE=LVCMOS33 DRIVE=8;

// High from the trigger to the end of the capture. Pin 75 also goes to a
// BL616 GPIO, which the stock debugger firmware leaves floating.
IO_LOC  "trig_out" 75;
IO_PORT "trig_out" IO_TYPE=LVCMOS33 DRIVE=8;
